import C "../src/backend/fund_currency/lib";
import T "../src/backend/fund_currency/types";
import Principal "mo:base/Principal";
assert(C.legacy(#ICP).decimals == 8);
assert(C.legacy(#ckUSDC).decimals == 6);
assert(C.legacy(#ckETH).decimals == 18);
assert(C.legacy(#ICRC("not-a-valid-principal")).decimals == 0);
assert(C.legacy(#ICRC("not-a-valid-principal")).ledger == null);
let cad:T.Currency={id="manual:CAD";symbol="CAD";name="Canadian dollar";decimals=2;ledger=null;enabled=true};
let entries:[T.Entry]=[{fundId=1;currency=cad}];
assert(C.list(entries,1,#ICP).size()==2);
assert(C.list(entries,2,#ICP).size()==1);
assert(C.find(entries,2,#ICP,"manual:CAD")==null);
assert(C.find(entries,1,#ICP,"manual:CAD")==?cad);
let icp=C.legacy(#ICP);
let overridden:[T.Entry]=[{fundId=1;currency={icp with enabled=false}}];
assert(C.list(overridden,1,#ICP).size()==1);
assert(C.find(overridden,1,#ICP,icp.id)==?{icp with enabled=false});
assert(C.validSymbol("CAD"));assert(not C.validSymbol("cad"));assert(not C.validSymbol("A B"));
assert(not C.validName("   "));
assert(not C.validMetadata("TEST","Token",19));
assert(C.ledgerId(Principal.fromText("aaaaa-aa"))=="ic:aaaaa-aa");
