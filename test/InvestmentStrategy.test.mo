import S "../src/backend/investment/strategy";
import Principal "mo:base/Principal";
import Debug "mo:base/Debug";
let owner=Principal.fromText("aaaaa-aa");
let now:Int=100;
let rules:S.Rules={maxWeight=25;staleDays=7;shock=20;thesis="Long term; review concentration"};
func ok(s:S.State,id:Text,op:S.Operation):S.State {switch(S.apply(s,1,owner,id,op,now)){case (#ok(next))next;case (#err(e))Debug.trap(e)}};
func fails(s:S.State,op:S.Operation):Bool {switch(S.apply(s,1,owner,"invalid",op,now)){case (#err(_))true;case _ false}};
let create:S.Operation=#policy({expectedRevision=0;rules});
let s1=ok(S.empty,"policy",create);
assert(S.current(s1,2)==null);
assert(switch(S.current(s1,1)){case (?p)p.revision==1;case _ false});
assert(ok(s1,"policy",create).policies.size()==1);
assert(fails(s1,create));
assert(fails(s1,#policy({expectedRevision=1;rules={rules with maxWeight=101}})));
assert(fails(s1,#policy({expectedRevision=1;rules={rules with thesis="  "}})));
let input:S.DecisionInput={investmentId=5;investmentRevision=2;policyRevision=1;action=#hold;rationale="Within thesis; reassess next week";reviewAt=now+86400000000000};
let s2=ok(s1,"decision",#decision(input));
assert(s2.decisions.size()==1 and s2.decisions[0].policy==S.current(s1,1));
assert(ok(s2,"decision",#decision(input)).decisions.size()==1);
assert(fails(s2,#decision({input with policyRevision=0})));
assert(fails(s2,#decision({input with reviewAt=now})));
assert(fails(s2,#decision({input with reviewAt=now+367*86400000000000})));
assert(fails(s2,#decision({input with rationale=" "})));
assert(switch(S.apply(s2,1,owner,"decision",create,now)){case (#err(_))true;case _ false});
assert(switch(S.apply(s2,1,Principal.fromText("2vxsx-fae"),"anon",create,now)){case (#err(_))true;case _ false});
let s3=ok(s2,"update",#policy({expectedRevision=1;rules={rules with maxWeight=30}}));
assert(s3.policies.size()==2 and s3.decisions[0].policy==S.current(s1,1));
assert(ok(s3,"decision",#decision(input)).decisions.size()==1);
Debug.print("Strategy versions, snapshot, validation, isolation and retry tests passed");
