import L "../src/backend/investment/lib";
import T "../src/backend/investment/types";
import Principal "mo:base/Principal";
import Debug "mo:base/Debug";
let caller=Principal.fromText("aaaaa-aa");
let meta:T.Metadata={name="ICP long term";definition=#currency("ICP");assetName="ICP";unit="ICP";decimals=8;currencyId="CAD";currency="CAD";moneyDecimals=2};
func ok(s:T.State,key:Text,op:T.Operation):(T.State,T.Investment){switch(L.apply(s,1,caller,key,op,1)){case (#ok(v))v;case (#err(e))Debug.trap(e)}};
let (s1,i1)=ok(L.empty,"create",#create(meta));
let buy:T.Operation=#record({id=i1.id;expectedRevision=1;action=#buy({locationId=1;quantity=100;amount=1000;fee=0});note="opening"});
let (s2,i2)=ok(s1,"buy",buy);assert(i2.quantity==100 and i2.cost==1000);
let (retry,replied)=ok(s2,"buy",buy);assert(retry.events.size()==2 and replied==i2);
assert(switch(L.apply(s2,1,caller,"buy",#create(meta),1)){case (#err(_))true;case _ false});
assert(switch(L.apply(s2,2,caller,"other",#record({id=i2.id;expectedRevision=2;action=#expense(1);note=""}),1)){case (#err(_))true;case _ false});
assert(switch(L.apply(s2,1,caller,"stale",buy,1)){case (#err(_))true;case _ false});
func record(s:T.State,i:T.Investment,key:Text,a:T.Action):(T.State,T.Investment){ok(s,key,#record({id=i.id;expectedRevision=i.revision;action=a;note=""}))};
let (s3,i3)=record(s2,i2,"sell",#sell({locationId=1;quantity=30;amount=400;fee=0}));assert(i3.cost==700 and i3.realized==100);
let (s4,i4)=record(s3,i3,"value",#valuation({amount=650;source="manual"}));assert(i4.valuation!=null);
let (s5,i5)=record(s4,i4,"move",#transfer({from=1;to=2;quantity=20;fee=5}));assert(i5.quantity==70 and i5.cost==700 and i5.realized==95 and i5.valuation==i4.valuation);
let (s6,i6)=record(s5,i5,"income",#income({amount=40;fee=2}));assert(i6.realized==133);
let (s7,i7)=record(s6,i6,"additional",#buy({locationId=1;quantity=30;amount=300;fee=10}));assert(i7.quantity==100 and i7.valuation==null and i7.cost==1010);
assert(switch(L.apply(s7,1,caller,"oversell",#record({id=i7.id;expectedRevision=i7.revision;action=#sell({locationId=2;quantity=21;amount=0;fee=0});note=""}),1)){case (#err(_))true;case _ false});
let (s8,i8)=record(s7,i7,"zero",#valuation({amount=0;source="total loss"}));assert(i8.valuation!=null);
let (s9,i9)=record(s8,i8,"exitA",#sell({locationId=1;quantity=80;amount=0;fee=0}));
let (_,i10)=record(s9,i9,"exitB",#sell({locationId=2;quantity=20;amount=0;fee=5}));assert(i10.quantity==0 and i10.cost==0 and i10.realized < 0);
assert(switch(L.apply(s9,1,Principal.fromText("2vxsx-fae"),"anon",#create(meta),1)){case (#err(_))true;case _ false});
Debug.print("Investment ledger tests passed");
