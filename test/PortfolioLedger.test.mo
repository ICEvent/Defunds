import Permissions "../src/backend/portfolio/permissions";
import L "../src/backend/portfolio/ledger";
import T "../src/backend/portfolio/types";
import Principal "mo:base/Principal";
let user = Principal.fromText("aaaaa-aa");
let other = Principal.fromText("rrkah-fqaaa-aaaaa-aaaaq-cai");
let create : T.Operation = #create({ name = "ETH"; category = "crypto"; unit = "ETH"; decimals = 2; quantity = 200; source = null; note = "opening" });
func ok(r : {#ok : (T.State, T.Asset); #err : Text}) : (T.State, T.Asset) { switch r { case (#ok(v)) v; case (#err(_)) { assert false; loop {} } } };
func failed(r : {#ok : (T.State, T.Asset); #err : Text}) { switch r { case (#err(_)) {}; case (_) assert false } };
func change(a : T.Asset, c : T.Change) : T.Operation { #change({ assetId = a.id; expectedRevision = a.revision; change = c; note = "test" }) };
let (s1,a1) = ok(L.apply(L.empty, 1, user, "create", create, 1));
assert (a1.quantity == 200 and s1.events.size() == 1);
let (replay, replayAsset) = ok(L.apply(s1, 1, user, "create", create, 2));
assert (replay == s1 and replayAsset == a1);
failed(L.apply(s1, 1, user, "create", #create({name="Other";category="other";unit="item";decimals=0;quantity=0;source=null;note=""}), 2));
failed(L.apply(s1, 1, Principal.fromText("2vxsx-fae"), "anon", create, 2));
failed(L.apply(s1, 2, user, "cross", change(a1,#increase(100)), 2));
let increase = change(a1,#increase(100));
let (s2,a2) = ok(L.apply(s1,1,user,"increase",increase,2));
assert (a2.quantity == 300);
failed(L.apply(s2,1,user,"stale",change(a1,#decrease(50)),3));
let (s3,a3) = ok(L.apply(s2,1,user,"decrease",change(a2,#decrease(50)),3));
assert (a3.quantity == 250);
failed(L.apply(s3,1,user,"overdraw",change(a3,#decrease(251)),4));
assert (s3.events.size() == 3);
let (s4,a4) = ok(L.apply(s3,1,user,"value",change(a3,#valuation({amount=720000;currency="USD";decimals=2})),4));
assert (a4.quantity == 250 and L.validValuation(a4) != null);
let (s5,a5) = ok(L.apply(s4,1,user,"more",change(a4,#increase(1)),5));
assert (L.validValuation(a5) == null);
let (s6,a6) = ok(L.apply(s5,1,user,"reverse",change(a5,#reverse(s5.events[4].id)),6));
assert (a6.quantity == 250);
failed(L.apply(s6,1,user,"reverse-twice",change(a6,#reverse(s5.events[4].id)),7));
failed(L.apply(s6,1,user,"reverse-value",change(a6,#reverse(s4.events[3].id)),7));
failed(L.apply(s6,1,user,"archive-nonzero",change(a6,#archive(true)),7));
failed(L.apply(s6,1,user,"dispose-nonzero",change(a6,#details({name="ETH";category="crypto";status=#disposed})),7));
let (s7,a7) = ok(L.apply(s6,1,user,"exit",change(a6,#decrease(250)),7));
let (s8,a8) = ok(L.apply(s7,1,user,"archive",change(a7,#archive(true)),8));
failed(L.apply(s8,1,user,"archived-write",change(a8,#increase(1)),9));
let (s9,a9) = ok(L.apply(s8,1,user,"restore",change(a8,#archive(false)),9));
assert (not a9.archived and s9.events.size() == 9);
failed(L.apply(s9,1,user,"negative-reversal",change(a9,#reverse(1)),10));
let (s10,a10) = ok(L.apply(s9,1,user,"zero-value",change(a9,#valuation({amount=0;currency="CAD";decimals=2})),10));
assert (L.validValuation(a10) != null);
let (_, differentUser) = ok(L.apply(s10,1,other,"create",create,11));
assert (differentUser.id != a1.id);
let ref = ?{network="ic";canisterId=other;assetId=1};
let referenced : T.Operation = #create({name="Boat";category="equipment";unit="boat";decimals=0;quantity=1;source=ref;note=""});
let (sr,_) = ok(L.apply(s10,1,user,"boat",referenced,11));
failed(L.apply(sr,1,user,"duplicate-boat",referenced,12));
ignore ok(L.apply(sr,2,user,"other-fund-boat",referenced,12));
failed(L.apply(sr,1,user,"bad-currency",change(a10,#valuation({amount=1;currency="cad";decimals=2})),13));

// Same policy used by every actor read/write endpoint. Stale manager entries
// never override live membership; zero-vote members remain eligible readers.
let outsider = Principal.fromText("ryjl3-tyaaa-aaaaa-aaaba-cai");
assert (Permissions.canAccess(user,user,[],[],true));
assert (Permissions.canAccess(other,user,[other],[],false));
assert (not Permissions.canAccess(other,user,[other],[],true));
assert (Permissions.canAccess(other,user,[other],[other],true));
assert (not Permissions.canAccess(other,user,[],[other],true));
assert (not Permissions.canAccess(outsider,user,[other],[other],false));
assert (not Permissions.canAccess(Principal.fromText("2vxsx-fae"),user,[],[],false));
